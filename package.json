{
  "name": "svg-review-app",
  "version": "1.0.0",
  "description": "Browser-local SVG optimization review: compare pixels and export a reproducible SVGO verification pack.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build --base=./",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "jszip": "3.10.1",
    "pixelmatch": "8.0.0",
    "svgo": "4.1.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "6.4.1"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.13"
  },
  "license": "MIT"
}
